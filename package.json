{
  "name": "@siddheshtawde/why-did-it-render",
  "version": "1.0.1",
  "description": "A tiny dev-only React hook that logs exactly which props changed and caused a re-render — no heavy profiler required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "react",
    "hooks",
    "debug",
    "re-render",
    "why-did-you-update",
    "performance",
    "devtools"
  ],
  "author": "Siddhesh Tawde",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiddheshTawde/why-did-it-render.git"
  },
  "bugs": {
    "url": "https://github.com/SiddheshTawde/why-did-it-render/issues"
  },
  "homepage": "https://github.com/SiddheshTawde/why-did-it-render#readme"
}
